#!/bin/bash
DIR="$(dirname "$0")"
source $DIR/console-defs

LN_MAYBE() {
  if [ -e "$2" ]; then
    if [ "$(readlink "$2")" == "$1" ]; then
      INFO "$2 -> $1 (OK)"
    else
      WARN "$2 exists and cannot linking $1"
      exit 1
    fi
  else
    ln -sfn "$1" "$2"
  fi
}

TIMESTAMP BEGIN

INFO initializing home directory...
cd ~
LN_MAYBE ~/sc-dev/mac/bin ~/bin
LN_MAYBE ~/sc-dev/vimrc ~/.vimrc
LN_MAYBE ~/sc-dev/mac/tmux.conf ~/.tmux.conf
LN_MAYBE ~/sc-dev/indent.pro ~/.indent.pro
LN_MAYBE ~/sc-dev/astyle.rc ~/.astylerc
[ -L ~/.config ] && { ERROR ~/.config is a symbolic link; remove it and rerun; exit 1; }
mkdir -p ~/.config
LN_MAYBE ~/sc-dev/config/nvim ~/.config/nvim
mkdir -p $DIR/../../local
LOCAL=`realpath $DIR/../../local`

INFO setting up git global configuration
git config --global user.email "karl@firepick.org"
git config --global user.name "Karl Lew"
git config --global push.default simple
git config --global pull.rebase	true
brew install -q git-lfs

if [ -e .bashrc ]; then
    cmp .bashrc sc-dev/mac/.bashrc
    RC=$?; if [ "$RC" != "0" ]; then
        mv -f .bashrc .bashrc.old
    fi
fi
ln -sf ~/sc-dev/mac/.bashrc .bashrc
grep -q 'bashrc' .bash_profile 2>/dev/null || echo '[ -f ~/.bashrc ] && . ~/.bashrc' >> .bash_profile

INFO installing console tools
brew install -q vim
brew install -q neovim
brew install -q tmux

INFO installing performance tools
brew install -q asitop
brew install -q btop
brew install -q nvtop
brew install -q iftop
brew install -q htop

INFO install AV tools
brew install -q ffmpeg

INFO instlling Node tools
[ -s "$HOME/.nvm/nvm.sh" ]
RC=$?
INFO nvm $RC
if [ $RC -ne 0 ]; then
  INFO Installing nvm
  curl -fo $LOCAL/nvm-install.sh https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.8/install.sh
  echo "48a0eee9a60e07422dce0eb5774754c83889570ca1ee2566c516acbe8af03a9e  $LOCAL/nvm-install.sh" | shasum -a 256 -c - || { ERROR nvm checksum mismatch; exit 1; }
  chmod +x $LOCAL/nvm-install.sh
  $LOCAL/nvm-install.sh; CHKRC
  echo RC$RC
fi
export NVM_DIR="$HOME/.nvm"
. "$NVM_DIR/nvm.sh"
INFO nvm `nvm --version`
nvm install 24
INFO nodejs `node --version`

INFO installing AI tools
brew install -q --cask visual-studio-code
brew install -q jundot/omlx/omlx

WARN "----------- IMPORTANT -----------------"
WARN "oMLX:   use gemma-4-26b-a4b-it-8bit"
WARN "bash:   reboot to get latest node"

TIMESTAMP END

